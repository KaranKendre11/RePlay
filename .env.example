# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required for the discovery run (M4). Replay never needs it.
OPENAI_API_KEY=

# Model used for the discovery loop.
REPLAY_MODEL=gpt-4o

# Where the hostile target app is served (M1).
MERIDIAN_BASE_URL=http://localhost:8080
MERIDIAN_VARIANT_URL=http://localhost:8081
